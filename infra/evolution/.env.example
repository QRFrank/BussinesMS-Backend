# Copiar a ".env" y completar los dos valores CAMBIAR_*. El .env NO se versiona.

# --- Servidor ---
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

# --- Autenticacion: apikey global (la misma va en el backend: WhatsApp:Evolution:ApiKey) ---
AUTHENTICATION_API_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_ALEATORIA
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- Postgres propio de Evolution ---
POSTGRES_USER=evolution
POSTGRES_PASSWORD=CAMBIAR_POR_OTRA_CLAVE_ALEATORIA
POSTGRES_DB=evolution
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:CAMBIAR_POR_OTRA_CLAVE_ALEATORIA@evolution-postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=bussinesms

# --- Solo mandamos avisos: no guardar historial de mensajes, chats ni contactos ---
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# --- Redis propio ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=bussinesms
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# --- Otros ---
DEL_INSTANCE=false
LANGUAGE=es
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error

# Si el QR no aparece o el celular dice "no se pudo vincular", probar fijando la version de WhatsApp Web:
# CONFIG_SESSION_PHONE_VERSION=2.3000.1023204200
